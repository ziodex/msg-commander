{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"types": ["node", "vite/client", "electron-vite/node"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/renderer/src/*"],
			"@shared/*": ["src/shared/*"]
		},
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src/**/*", "tests/**/*.ts", "*.config.ts"]
}
